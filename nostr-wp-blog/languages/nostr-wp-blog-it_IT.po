# Italian translation for Nostr WP Blog
msgid ""
msgstr ""
"Project-Id-Version: Nostr WP Blog 1.0.0\n"
"Language: it_IT\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Nostr WP Blog: run Composer in the plugin directory (composer install) so vendor/autoload.php exists."
msgstr "Nostr WP Blog: esegui Composer nella cartella del plugin (composer install) così che esista vendor/autoload.php."

msgid "Read article"
msgstr "Leggi articolo"

msgid "By %s"
msgstr "Di %s"

msgid "No articles yet. Run a sync from Settings → Nostr blog."
msgstr "Nessun articolo ancora. Esegui una sincronizzazione da Impostazioni → Blog Nostr."

msgid "Every 15 minutes"
msgstr "Ogni 15 minuti"

msgid "Nostr blog"
msgstr "Blog Nostr"

msgid "Authors (npub or hex pubkey, one per line)"
msgstr "Autori (npub o chiave pubblica hex, uno per riga)"

msgid "Relays (wss://, one per line)"
msgstr "Relay (wss://, uno per riga)"

msgid "NIP-05 verification"
msgstr "Verifica NIP-05"

msgid "Serve /.well-known/nostr.json for NIP-05"
msgstr "Esporre /.well-known/nostr.json per NIP-05"

msgid "Nostr clients request this URL with a name query argument and receive the matching hex pubkey plus the relay list from this page."
msgstr "I client Nostr richiedono questo URL con il parametro name e ricevono la chiave pubblica hex corrispondente e l’elenco relay configurato in questa pagina."

msgid "Local names are taken from each author’s kind 0 profile (short “name” field, then display name). Mappings are refreshed when you save these settings."
msgstr "I nomi locali provengono dal profilo kind 0 di ogni autore (campo breve «name», poi nome visualizzato). Le mappature si aggiornano salvando queste impostazioni."

msgid "Current NIP-05 names"
msgstr "Nomi NIP-05 attuali"

msgid "No identities yet. Add authors and relays above, enable this option, and save to fetch profiles and build names."
msgstr "Nessuna identità ancora. Aggiungi autori e relay sopra, abilita l’opzione e salva per scaricare i profili e costruire i nomi."

msgid "NIP-05: no kind 0 profile was found on your relays for %d author(s); fallback local names were used. Check relays and author npubs."
msgstr "NIP-05: nessun profilo kind 0 trovato sui relay per %d autore/i; sono stati usati nomi locali di fallback. Controlla relay e npub degli autori."

msgid "Nostr login"
msgstr "Accesso Nostr"

msgid "Allow signing in with a Nostr extension (NIP-07)"
msgstr "Consenti l’accesso con un’estensione Nostr (NIP-07)"

msgid "On wp-login.php, authors listed above can log in as the selected WordPress user by signing a NIP-42 authentication event (kind 22242)."
msgstr "Su wp-login.php, gli autori elencati sopra possono accedere come l’utente WordPress selezionato firmando un evento di autenticazione NIP-42 (kind 22242)."

msgid "WordPress user to log in as"
msgstr "Utente WordPress con cui accedere"

msgid "— Select —"
msgstr "— Seleziona —"

msgid "Nostr login was turned off: choose a WordPress user and add at least one author npub or hex pubkey."
msgstr "Accesso Nostr disattivato: scegli un utente WordPress e aggiungi almeno un npub o pubkey hex tra gli autori."

msgid "Sign in with Nostr"
msgstr "Accedi con Nostr"

msgid "No Nostr extension found. Install a NIP-07-capable browser extension and try again."
msgstr "Nessuna estensione Nostr trovata. Installa un’estensione compatibile con NIP-07 e riprova."

msgid "Waiting for signature…"
msgstr "In attesa della firma…"

msgid "Nostr sign-in failed."
msgstr "Accesso Nostr non riuscito."

msgid "This key is not listed as an author for this site."
msgstr "Questa chiave non è tra gli autori di questo sito."

msgid "Nostr login is not available."
msgstr "L’accesso Nostr non è disponibile."

msgid "Invalid or expired security token. Reload the login page."
msgstr "Token di sicurezza non valido o scaduto. Ricarica la pagina di accesso."

msgid "Invalid public key."
msgstr "Chiave pubblica non valida."

msgid "Sign-in session expired. Try again."
msgstr "Sessione di accesso scaduta. Riprova."

msgid "Invalid signed event."
msgstr "Evento firmato non valido."

msgid "Signature verification failed."
msgstr "Verifica della firma non riuscita."

msgid "Wrong event kind."
msgstr "Tipo di evento errato."

msgid "Public key mismatch."
msgstr "La chiave pubblica non corrisponde."

msgid "Challenge mismatch."
msgstr "Il challenge non corrisponde."

msgid "Relay tag mismatch."
msgstr "Il tag relay non corrisponde."

msgid "Event timestamp is too far from server time."
msgstr "Il timestamp dell’evento è troppo lontano dall’ora del server."

msgid "Nostr login is not configured."
msgstr "L’accesso Nostr non è configurato."

msgid "Invalid session."
msgstr "Sessione non valida."

msgid "Archive URL slug"
msgstr "Slug URL archivio"

msgid "List of articles: https://yoursite.example/{slug}/"
msgstr "Elenco articoli: https://yoursite.example/{slug}/"

msgid "Archive page title"
msgstr "Titolo pagina archivio"

msgid "Heading shown above the article list. Leave empty to use the default WordPress title for this archive."
msgstr "Intestazione sopra l’elenco articoli. Lascia vuoto per usare il titolo di archivio predefinito di WordPress."

msgid "Single article URLs"
msgstr "URL articoli singoli"

msgid "Under archive slug (recommended)"
msgstr "Sotto lo slug archivio (consigliato)"

msgid "Site root (one path segment; may collide with pages)"
msgstr "Radice del sito (un segmento di percorso; può collidere con le pagine)"

msgid "Show topic tags under each article"
msgstr "Mostra i tag argomento sotto ogni articolo"

msgid "Tags come from Nostr hashtag tags (t) on the article event. Run sync after changing authors or relays to refresh stored tags."
msgstr "I tag provengono dagli hashtag Nostr (t) sull’evento articolo. Esegui una sincronizzazione dopo aver modificato autori o relay per aggiornare i tag memorizzati."

msgid "Tags"
msgstr "Tag"

msgid "Sync interval"
msgstr "Intervallo di sincronizzazione"

msgid "Hourly"
msgstr "Ogni ora"

msgid "Twice daily"
msgstr "Due volte al giorno"

msgid "Daily"
msgstr "Giornaliero"

msgid "Relay request timeout (seconds)"
msgstr "Timeout richiesta relay (secondi)"

msgid "Max events per relay"
msgstr "Max eventi per relay"

msgid "Save changes"
msgstr "Salva modifiche"

msgid "Manual sync"
msgstr "Sincronizzazione manuale"

msgid "Sync now"
msgstr "Sincronizza ora"

msgid "Status"
msgstr "Stato"

msgid "Published articles: %d"
msgstr "Articoli pubblicati: %d"

msgid "No sync has been recorded in these settings yet, but you already have published articles. They may have been created manually, imported, or synced on another copy of the site. Run Sync now to refresh from relays and update this status."
msgstr "Non risulta ancora alcuna sincronizzazione in queste impostazioni, ma hai già articoli pubblicati. Potrebbero essere stati creati manualmente, importati o sincronizzati su un’altra copia del sito. Usa Sincronizza ora per aggiornare dai relay e aggiornare questo stato."

msgid "Last sync: %s"
msgstr "Ultima sincronizzazione: %s"

msgid "No sync has completed yet."
msgstr "Nessuna sincronizzazione completata finora."

msgid "Articles updated in last run: %d"
msgstr "Articoli aggiornati nell’ultima esecuzione: %d"

msgid "Last errors"
msgstr "Ultimi errori"

msgid "Forbidden."
msgstr "Accesso negato."

msgid "Settings saved. Rewrite rules were flushed."
msgstr "Impostazioni salvate. Le regole di riscrittura sono state aggiornate."

msgid "Sync finished."
msgstr "Sincronizzazione completata."

msgid "Nostr articles"
msgstr "Articoli Nostr"

msgid "Nostr article"
msgstr "Articolo Nostr"

msgid "Add New"
msgstr "Aggiungi nuovo"

msgid "Add New Article"
msgstr "Aggiungi nuovo articolo"

msgid "Edit Article"
msgstr "Modifica articolo"

msgid "New Article"
msgstr "Nuovo articolo"

msgid "View Article"
msgstr "Visualizza articolo"

msgid "Search Articles"
msgstr "Cerca articoli"

msgid "No articles found"
msgstr "Nessun articolo trovato"

msgid "No articles found in Trash"
msgstr "Nessun articolo nel cestino"

msgid "No author npubs or pubkeys configured."
msgstr "Nessun npub autore o chiave pubblica configurata."

msgid "No relay URLs configured."
msgstr "Nessun URL relay configurato."

msgid "Relay %1$s: %2$s"
msgstr "Relay %1$s: %2$s"
