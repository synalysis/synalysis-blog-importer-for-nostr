# Spanish (Spain) translation for Nostr WP Blog
msgid ""
msgstr ""
"Project-Id-Version: Nostr WP Blog 1.1.1\n"
"Language: es_ES\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Nostr WP Blog: run Composer in the plugin directory (composer install) so vendor/autoload.php exists."
msgstr "Nostr WP Blog: ejecuta Composer en el directorio del plugin (composer install) para que exista vendor/autoload.php."

msgid "Read article"
msgstr "Leer artículo"

msgid "By %s"
msgstr "Por %s"

msgid "No articles yet. Run a sync from Settings → Nostr blog."
msgstr "Aún no hay artículos. Sincroniza desde Ajustes → Blog Nostr."

msgid "Every 15 minutes"
msgstr "Cada 15 minutos"

msgid "Nostr blog"
msgstr "Blog Nostr"

msgid "Authors (npub or hex pubkey, one per line)"
msgstr "Autores (npub o clave pública hex, uno por línea)"

msgid "Relays (wss://, one per line)"
msgstr "Relays (wss://, uno por línea)"

msgid "NIP-05 verification"
msgstr "Verificación NIP-05"

msgid "Serve /.well-known/nostr.json for NIP-05"
msgstr "Servir /.well-known/nostr.json para NIP-05"

msgid "Nostr clients request this URL with a name query argument and receive the matching hex pubkey plus the relay list from this page."
msgstr "Los clientes Nostr solicitan esta URL con el parámetro de consulta name y reciben la clave pública hex correspondiente más la lista de relays de esta página."

msgid "Local names are taken from each author’s kind 0 profile (short “name” field, then display name). Mappings are refreshed when you save these settings."
msgstr "Los nombres locales salen del perfil kind 0 de cada autor (campo corto «name», luego nombre para mostrar). Las asignaciones se actualizan al guardar estos ajustes."

msgid "Current NIP-05 names"
msgstr "Nombres NIP-05 actuales"

msgid "No identities yet. Add authors and relays above, enable this option, and save to fetch profiles and build names."
msgstr "Aún no hay identidades. Añada autores y relays arriba, active la opción y guarde para obtener perfiles y generar nombres."

msgid "NIP-05: no kind 0 profile was found on your relays for %d author(s); fallback local names were used. Check relays and author npubs."
msgstr "NIP-05: no se encontró perfil kind 0 en sus relays para %d autor(es); se usaron nombres locales de reserva. Revise relays y npubs de autores."

msgid "Nostr login"
msgstr "Inicio de sesión Nostr"

msgid "Allow signing in with a Nostr extension (NIP-07)"
msgstr "Permitir iniciar sesión con una extensión Nostr (NIP-07)"

msgid "On wp-login.php, authors listed above can log in as the selected WordPress user by signing a NIP-42 authentication event (kind 22242)."
msgstr "En wp-login.php, los autores indicados arriba pueden iniciar sesión como el usuario de WordPress seleccionado firmando un evento de autenticación NIP-42 (kind 22242)."

msgid "WordPress user to log in as"
msgstr "Usuario de WordPress para iniciar sesión"

msgid "— Select —"
msgstr "— Seleccionar —"

msgid "Nostr login was turned off: choose a WordPress user and add at least one author npub or hex pubkey."
msgstr "El inicio de sesión Nostr se desactivó: elija un usuario de WordPress y añada al menos un npub o pubkey hex de autor."

msgid "Sign in with Nostr"
msgstr "Iniciar sesión con Nostr"

msgid "No Nostr extension found. Install a NIP-07-capable browser extension and try again."
msgstr "No se encontró extensión Nostr. Instale una extensión compatible con NIP-07 e inténtelo de nuevo."

msgid "Waiting for signature…"
msgstr "Esperando la firma…"

msgid "Nostr sign-in failed."
msgstr "Error al iniciar sesión con Nostr."

msgid "This key is not listed as an author for this site."
msgstr "Esta clave no figura como autora de este sitio."

msgid "Nostr login is not available."
msgstr "El inicio de sesión Nostr no está disponible."

msgid "Invalid or expired security token. Reload the login page."
msgstr "Token de seguridad no válido o caducado. Recargue la página de acceso."

msgid "Invalid public key."
msgstr "Clave pública no válida."

msgid "Sign-in session expired. Try again."
msgstr "La sesión de acceso caducó. Inténtelo de nuevo."

msgid "Invalid signed event."
msgstr "Evento firmado no válido."

msgid "Signature verification failed."
msgstr "Falló la verificación de la firma."

msgid "Wrong event kind."
msgstr "Tipo de evento incorrecto."

msgid "Public key mismatch."
msgstr "La clave pública no coincide."

msgid "Challenge mismatch."
msgstr "El challenge no coincide."

msgid "Relay tag mismatch."
msgstr "La etiqueta relay no coincide."

msgid "Event timestamp is too far from server time."
msgstr "La marca de tiempo del evento está demasiado lejos de la hora del servidor."

msgid "Nostr login is not configured."
msgstr "El inicio de sesión Nostr no está configurado."

msgid "Invalid session."
msgstr "Sesión no válida."

msgid "Archive URL slug"
msgstr "Slug de URL del archivo"

msgid "List of articles: https://yoursite.example/{slug}/"
msgstr "Lista de artículos: https://yoursite.example/{slug}/"

msgid "Archive page title"
msgstr "Título de la página de archivo"

msgid "Heading shown above the article list. Leave empty to use the default WordPress title for this archive."
msgstr "Encabezado mostrado sobre la lista de artículos. Déjelo vacío para usar el título de archivo predeterminado de WordPress."

msgid "Single article URLs"
msgstr "URLs de artículos individuales"

msgid "Under archive slug (recommended)"
msgstr "Bajo el slug del archivo (recomendado)"

msgid "Site root (one path segment; may collide with pages)"
msgstr "Raíz del sitio (un segmento de ruta; puede chocar con páginas)"

msgid "Show topic tags under each article"
msgstr "Mostrar etiquetas de tema debajo de cada artículo"

msgid "Tags come from Nostr hashtag tags (t) on the article event. Run sync after changing authors or relays to refresh stored tags."
msgstr "Las etiquetas provienen de los hashtags Nostr (t) del evento del artículo. Sincronice tras cambiar autores o relays para actualizar las etiquetas guardadas."

msgid "Tags"
msgstr "Etiquetas"

msgid "Sync interval"
msgstr "Intervalo de sincronización"

msgid "Hourly"
msgstr "Cada hora"

msgid "Twice daily"
msgstr "Dos veces al día"

msgid "Daily"
msgstr "Diario"

msgid "Relay request timeout (seconds)"
msgstr "Tiempo de espera del relay (segundos)"

msgid "Max events per relay"
msgstr "Máx. de eventos por relay"

msgid "Save changes"
msgstr "Guardar cambios"

msgid "Manual sync"
msgstr "Sincronización manual"

msgid "Sync now"
msgstr "Sincronizar ahora"

msgid "Status"
msgstr "Estado"

msgid "Published articles: %d"
msgstr "Artículos publicados: %d"

msgid "No sync has been recorded in these settings yet, but you already have published articles. They may have been created manually, imported, or synced on another copy of the site. Run Sync now to refresh from relays and update this status."
msgstr "Aún no consta ninguna sincronización en estos ajustes, pero ya hay artículos publicados. Pueden haberse creado manualmente, importarse o sincronizarse en otra copia del sitio. Pulse Sincronizar ahora para actualizar desde los relays y registrar el estado."

msgid "Last sync: %s"
msgstr "Última sincronización: %s"

msgid "No sync has completed yet."
msgstr "Aún no se ha completado ninguna sincronización."

msgid "Articles updated in last run: %d"
msgstr "Artículos actualizados en la última ejecución: %d"

msgid "Last errors"
msgstr "Últimos errores"

msgid "Forbidden."
msgstr "Prohibido."

msgid "Settings saved. Rewrite rules were flushed."
msgstr "Ajustes guardados. Las reglas de reescritura se han actualizado."

msgid "Sync finished."
msgstr "Sincronización finalizada."

msgid "Nostr articles"
msgstr "Artículos Nostr"

msgid "Nostr article"
msgstr "Artículo Nostr"

msgid "Add New"
msgstr "Añadir nuevo"

msgid "Add New Article"
msgstr "Añadir nuevo artículo"

msgid "Edit Article"
msgstr "Editar artículo"

msgid "New Article"
msgstr "Nuevo artículo"

msgid "View Article"
msgstr "Ver artículo"

msgid "Search Articles"
msgstr "Buscar artículos"

msgid "No articles found"
msgstr "No se encontraron artículos"

msgid "No articles found in Trash"
msgstr "No hay artículos en la papelera"

msgid "No author npubs or pubkeys configured."
msgstr "No hay npubs de autor ni claves públicas configuradas."

msgid "No relay URLs configured."
msgstr "No hay URLs de relay configuradas."

msgid "Relay %1$s: %2$s"
msgstr "Relay %1$s: %2$s"
