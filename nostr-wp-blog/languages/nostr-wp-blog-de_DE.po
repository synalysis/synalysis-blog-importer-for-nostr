# German translation for Nostr WP Blog
msgid ""
msgstr ""
"Project-Id-Version: Nostr WP Blog 1.1.1\n"
"Language: de_DE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Nostr WP Blog: run Composer in the plugin directory (composer install) so vendor/autoload.php exists."
msgstr "Nostr WP Blog: Führen Sie im Plugin-Verzeichnis „composer install“ aus, damit vendor/autoload.php vorhanden ist."

msgid "Read article"
msgstr "Artikel lesen"

msgid "By %s"
msgstr "Von %s"

msgid "No articles yet. Run a sync from Settings → Nostr blog."
msgstr "Noch keine Artikel. Synchronisieren Sie unter „Einstellungen → Nostr-Blog“."

msgid "Every 15 minutes"
msgstr "Alle 15 Minuten"

msgid "Nostr blog"
msgstr "Nostr-Blog"

msgid "Authors (npub or hex pubkey, one per line)"
msgstr "Autoren (npub oder Hex-Pubkey, eine Zeile pro Eintrag)"

msgid "Relays (wss://, one per line)"
msgstr "Relays (wss://, eine Zeile pro Eintrag)"

msgid "NIP-05 verification"
msgstr "NIP-05-Verifizierung"

msgid "Serve /.well-known/nostr.json for NIP-05"
msgstr "/.well-known/nostr.json für NIP-05 bereitstellen"

msgid "Nostr clients request this URL with a name query argument and receive the matching hex pubkey plus the relay list from this page."
msgstr "Nostr-Clients rufen diese URL mit dem Abfrageparameter name auf und erhalten den passenden Hex-Pubkey sowie die Relay-Liste von dieser Seite."

msgid "Local names are taken from each author’s kind 0 profile (short “name” field, then display name). Mappings are refreshed when you save these settings."
msgstr "Lokale Namen stammen vom Kind-0-Profil jedes Autors (kurzes „name“-Feld, sonst Anzeigename). Die Zuordnungen werden beim Speichern dieser Einstellungen aktualisiert."

msgid "Current NIP-05 names"
msgstr "Aktuelle NIP-05-Namen"

msgid "No identities yet. Add authors and relays above, enable this option, and save to fetch profiles and build names."
msgstr "Noch keine Identitäten. Autoren und Relays oben eintragen, diese Option aktivieren und speichern, um Profile abzurufen und Namen zu erzeugen."

msgid "NIP-05: no kind 0 profile was found on your relays for %d author(s); fallback local names were used. Check relays and author npubs."
msgstr "NIP-05: Für %d Autor(en) wurde auf Ihren Relays kein Kind-0-Profil gefunden; es wurden Fallback-Namen verwendet. Prüfen Sie Relays und Autoren-Npubs."

msgid "Nostr login"
msgstr "Nostr-Anmeldung"

msgid "Allow signing in with a Nostr extension (NIP-07)"
msgstr "Anmeldung mit einer Nostr-Browsererweiterung (NIP-07) erlauben"

msgid "On wp-login.php, authors listed above can log in as the selected WordPress user by signing a NIP-42 authentication event (kind 22242)."
msgstr "Auf wp-login.php können die oben genannten Autoren sich als der ausgewählte WordPress-Benutzer anmelden, indem sie ein NIP-42-Authentifizierungs-Event (Kind 22242) signieren."

msgid "WordPress user to log in as"
msgstr "WordPress-Benutzer für die Anmeldung"

msgid "— Select —"
msgstr "— Auswählen —"

msgid "Nostr login was turned off: choose a WordPress user and add at least one author npub or hex pubkey."
msgstr "Nostr-Anmeldung wurde deaktiviert: Wählen Sie einen WordPress-Benutzer und tragen Sie mindestens einen Autoren-Npub oder Hex-Pubkey ein."

msgid "Sign in with Nostr"
msgstr "Mit Nostr anmelden"

msgid "No Nostr extension found. Install a NIP-07-capable browser extension and try again."
msgstr "Keine Nostr-Erweiterung gefunden. Installieren Sie eine NIP-07-fähige Browsererweiterung und versuchen Sie es erneut."

msgid "Waiting for signature…"
msgstr "Warte auf Signatur…"

msgid "Nostr sign-in failed."
msgstr "Nostr-Anmeldung fehlgeschlagen."

msgid "This key is not listed as an author for this site."
msgstr "Dieser Schlüssel ist für diese Website nicht als Autor eingetragen."

msgid "Nostr login is not available."
msgstr "Nostr-Anmeldung ist nicht verfügbar."

msgid "Invalid or expired security token. Reload the login page."
msgstr "Ungültiges oder abgelaufenes Sicherheitstoken. Laden Sie die Anmeldeseite neu."

msgid "Invalid public key."
msgstr "Ungültiger öffentlicher Schlüssel."

msgid "Sign-in session expired. Try again."
msgstr "Anmeldesitzung abgelaufen. Bitte erneut versuchen."

msgid "Invalid signed event."
msgstr "Ungültiges signiertes Event."

msgid "Signature verification failed."
msgstr "Signaturprüfung fehlgeschlagen."

msgid "Wrong event kind."
msgstr "Falsche Event-Art."

msgid "Public key mismatch."
msgstr "Öffentlicher Schlüssel stimmt nicht überein."

msgid "Challenge mismatch."
msgstr "Challenge stimmt nicht überein."

msgid "Relay tag mismatch."
msgstr "Relay-Tag stimmt nicht überein."

msgid "Event timestamp is too far from server time."
msgstr "Event-Zeitstempel weicht zu stark von der Serverzeit ab."

msgid "Nostr login is not configured."
msgstr "Nostr-Anmeldung ist nicht konfiguriert."

msgid "Invalid session."
msgstr "Ungültige Sitzung."

msgid "Archive URL slug"
msgstr "Archiv-URL-Slug"

msgid "List of articles: https://yoursite.example/{slug}/"
msgstr "Artikelübersicht: https://yoursite.example/{slug}/"

msgid "Archive page title"
msgstr "Archiv-Seitentitel"

msgid "Heading shown above the article list. Leave empty to use the default WordPress title for this archive."
msgstr "Überschrift über der Artikelliste. Leer lassen, um den standardmäßigen WordPress-Titel für dieses Archiv zu verwenden."

msgid "Single article URLs"
msgstr "URLs einzelner Artikel"

msgid "Under archive slug (recommended)"
msgstr "Unter Archiv-Slug (empfohlen)"

msgid "Site root (one path segment; may collide with pages)"
msgstr "Website-Stamm (ein Pfadsegment; kann mit Seiten kollidieren)"

msgid "Show topic tags under each article"
msgstr "Themen-Tags unter jedem Artikel anzeigen"

msgid "Tags come from Nostr hashtag tags (t) on the article event. Run sync after changing authors or relays to refresh stored tags."
msgstr "Tags stammen von Nostr-Hashtag-Tags (t) am Artikel-Event. Nach Änderung von Autoren oder Relays synchronisieren, um die gespeicherten Tags zu aktualisieren."

msgid "Tags"
msgstr "Tags"

msgid "Sync interval"
msgstr "Synchronisationsintervall"

msgid "Hourly"
msgstr "Stündlich"

msgid "Twice daily"
msgstr "Zweimal täglich"

msgid "Daily"
msgstr "Täglich"

msgid "Relay request timeout (seconds)"
msgstr "Relay-Anfrage-Timeout (Sekunden)"

msgid "Max events per relay"
msgstr "Max. Ereignisse pro Relay"

msgid "Save changes"
msgstr "Änderungen speichern"

msgid "Manual sync"
msgstr "Manuelle Synchronisation"

msgid "Sync now"
msgstr "Jetzt synchronisieren"

msgid "Status"
msgstr "Status"

msgid "Published articles: %d"
msgstr "Veröffentlichte Artikel: %d"

msgid "No sync has been recorded in these settings yet, but you already have published articles. They may have been created manually, imported, or synced on another copy of the site. Run Sync now to refresh from relays and update this status."
msgstr "In diesen Einstellungen ist noch keine Synchronisation protokolliert, aber es gibt bereits veröffentlichte Artikel. Sie können manuell angelegt, importiert oder auf einer anderen Site-Kopie synchronisiert worden sein. Führen Sie „Jetzt synchronisieren“ aus, um von den Relays zu aktualisieren und diesen Status zu setzen."

msgid "Last sync: %s"
msgstr "Letzte Synchronisation: %s"

msgid "No sync has completed yet."
msgstr "Noch keine Synchronisation abgeschlossen."

msgid "Articles updated in last run: %d"
msgstr "Artikel im letzten Lauf aktualisiert: %d"

msgid "Last errors"
msgstr "Letzte Fehler"

msgid "Forbidden."
msgstr "Keine Berechtigung."

msgid "Settings saved. Rewrite rules were flushed."
msgstr "Einstellungen gespeichert. Rewrite-Regeln wurden zurückgesetzt."

msgid "Sync finished."
msgstr "Synchronisation abgeschlossen."

msgid "Nostr articles"
msgstr "Nostr-Artikel"

msgid "Nostr article"
msgstr "Nostr-Artikel"

msgid "Add New"
msgstr "Neu hinzufügen"

msgid "Add New Article"
msgstr "Neuen Artikel hinzufügen"

msgid "Edit Article"
msgstr "Artikel bearbeiten"

msgid "New Article"
msgstr "Neuer Artikel"

msgid "View Article"
msgstr "Artikel ansehen"

msgid "Search Articles"
msgstr "Artikel suchen"

msgid "No articles found"
msgstr "Keine Artikel gefunden"

msgid "No articles found in Trash"
msgstr "Keine Artikel im Papierkorb"

msgid "No author npubs or pubkeys configured."
msgstr "Keine Autoren-Npubs oder Pubkeys konfiguriert."

msgid "No relay URLs configured."
msgstr "Keine Relay-URLs konfiguriert."

msgid "Relay %1$s: %2$s"
msgstr "Relay %1$s: %2$s"
